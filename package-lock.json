{
    "name": "flowops",
    "version": "0.1.0",
    "lockfileVersion": 3,
    "requires": true,
    "packages": {
        "": {
            "name": "flowops",
            "version": "0.1.0",
            "workspaces": [
                "gateway",
                "control-plane",
                "demo-upstream",
                "packages/*"
            ],
            "engines": {
                "node": ">=20"
            }
        },
        "control-plane": {
            "name": "@flowops/control-plane",
            "version": "0.1.0",
            "dependencies": {
                "@flowops/common": "*"
            }
        },
        "demo-upstream": {
            "name": "@flowops/demo-upstream",
            "version": "0.1.0",
            "dependencies": {
                "@flowops/common": "*"
            }
        },
        "gateway": {
            "name": "@flowops/gateway",
            "version": "0.1.0",
            "dependencies": {
                "@flowops/common": "*"
            }
        },
        "node_modules/@flowops/common": {
            "resolved": "packages/common",
            "link": true
        },
        "node_modules/@flowops/control-plane": {
            "resolved": "control-plane",
            "link": true
        },
        "node_modules/@flowops/demo-upstream": {
            "resolved": "demo-upstream",
            "link": true
        },
        "node_modules/@flowops/gateway": {
            "resolved": "gateway",
            "link": true
        },
        "packages/common": {
            "name": "@flowops/common",
            "version": "0.1.0"
        }
    }
}
